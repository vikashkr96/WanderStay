<% layout("layouts/boilerplate") %>
<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
  }

  body {
    background: #f4f7fb;
    color: #333;
    line-height: 1.7;
  }

  .terms-container {
    max-width: 1000px;
    margin: 50px auto;
    background: white;
    padding: 40px;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.1);
  }

  .terms-container h1 {
    color: #1e3a8a;
    margin-bottom: 10px;
    text-align: center;
  }

