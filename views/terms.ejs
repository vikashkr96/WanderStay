    color: gray;
    margin-bottom: 30px;
  }

  .terms-container h2 {
    color: #2563eb;
    margin-top: 30px;
    margin-bottom: 10px;
  }

  .terms-container p {
    margin-bottom: 15px;
  }

  .terms-container ul {
    margin-left: 20px;
    margin-bottom: 15px;
  }

  .terms-container li {
    margin-bottom: 8px;
  }

  .terms-footer {
    margin-top: 40px;
    text-align: center;
    color: gray;
    font-size: 14px;
  }

  .terms-container a {
    color: #2563eb;
    text-decoration: none;
  }

  .terms-container a:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .terms-container {
      margin: 20px;
      padding: 25px;
    }
  }
</style>

